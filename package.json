{
  "name": "ai-workbench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ai-workbench/desktop",
    "build": "npm run build -w @ai-workbench/desktop",
    "package:win": "npm run package:win -w @ai-workbench/desktop",
    "package:win-alpha": "npm run package:win-alpha -w @ai-workbench/desktop",
    "package:win-beta": "npm run package:win-beta -w @ai-workbench/desktop",
    "rebuild:native": "npm run rebuild:native -w @ai-workbench/desktop",
    "typecheck": "npm run typecheck -w @ai-workbench/desktop",
    "validate:workspace-regression": "npm run validate:workspace-regression -w @ai-workbench/desktop",
    "validate:workspace-web-capture": "npm run validate:workspace-web-capture -w @ai-workbench/desktop",
    "validate:workspace-retrieval": "npm run validate:workspace-retrieval -w @ai-workbench/desktop",
    "validate:custom-web-panels": "npm run validate:custom-web-panels -w @ai-workbench/desktop",
    "validate:terminal-panel-configuration": "npm run validate:terminal-panel-configuration -w @ai-workbench/desktop",
    "validate:terminal-behavior": "npm run validate:terminal-behavior -w @ai-workbench/desktop",
    "validate:remote-bridge-settings": "npm run validate:remote-bridge-settings -w @ai-workbench/desktop",
    "validate:remote-bridge-config-file": "npm run validate:remote-bridge-config-file -w @ai-workbench/desktop",
    "validate:feishu-remote-bridge": "npm run validate:feishu-remote-bridge -w @ai-workbench/desktop",
    "validate:feishu-remote-bridge-service": "npm run validate:feishu-remote-bridge-service -w @ai-workbench/desktop",
    "validate:remote-session-adapter": "npm run validate:remote-session-adapter -w @ai-workbench/desktop",
    "validate:remote-work-command-router": "npm run validate:remote-work-command-router -w @ai-workbench/desktop",
    "validate:remote-output-delivery": "npm run validate:remote-output-delivery -w @ai-workbench/desktop",
    "validate:remote-bridge-audit": "npm run validate:remote-bridge-audit -w @ai-workbench/desktop",
    "validate:terminal-remote-compatibility": "npm run validate:terminal-remote-compatibility -w @ai-workbench/desktop",
    "validate:codex-app-server-spike": "npm run validate:codex-app-server-spike -w @ai-workbench/desktop",
    "validate:structured-codex-adapter": "npm run validate:structured-codex-adapter -w @ai-workbench/desktop",
    "validate:remote-target-mode": "npm run validate:remote-target-mode -w @ai-workbench/desktop",
    "validate:workspace-profiles": "npm run validate:workspace-profiles -w @ai-workbench/desktop",
    "validate:visual-smoke": "npm run validate:visual-smoke -w @ai-workbench/desktop",
    "validate:renderer-startup": "npm run validate:renderer-startup -w @ai-workbench/desktop",
    "validate:renderer-entrypoint": "npm run validate:renderer-entrypoint -w @ai-workbench/desktop",
    "validate:security-boundaries": "npm run validate:security-boundaries -w @ai-workbench/desktop",
    "validate:openspec-active-changes": "npm run validate:openspec-active-changes -w @ai-workbench/desktop",
    "validate:internal-alpha": "npm run validate:internal-alpha -w @ai-workbench/desktop",
    "validate:package-win": "npm run validate:package-win -w @ai-workbench/desktop",
    "validate:package-win-beta": "npm run validate:package-win-beta -w @ai-workbench/desktop",
    "release:win-alpha": "npm run validate:internal-alpha && npm run package:win-alpha && npm run validate:package-win",
    "release:win-beta": "npm run validate:internal-alpha && npm run package:win-beta && npm run validate:package-win-beta"
  }
}
