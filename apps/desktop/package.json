{
  "name": "@ai-workbench/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "DeepWork desktop workbench",
  "author": "DeepWork",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run package:win-alpha",
    "package:win-alpha": "npm run build && electron-builder --config electron-builder.alpha.json --win dir --x64",
    "package:win-beta": "npm run build && electron-builder --config electron-builder.beta.json --win dir --x64",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "validate:workspace-regression": "node validation/workspace-regression/run-workspace-regression.mjs",
    "validate:workspace-web-capture": "node validation/workspace-web-capture/run-workspace-web-capture-validation.mjs",
    "validate:workspace-retrieval": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File validation/workspace-retrieval/run-workspace-retrieval-validation.ps1",
    "validate:custom-web-panels": "node validation/custom-web-panels/run-custom-web-panels-validation.mjs",
    "validate:terminal-panel-configuration": "node validation/terminal-panel-configuration/run-terminal-panel-configuration-validation.mjs",
    "validate:terminal-behavior": "node validation/terminal-behavior/run-terminal-behavior-validation.mjs",
    "validate:remote-bridge-settings": "node validation/remote-bridge-settings/run-remote-bridge-settings-validation.mjs",
    "validate:remote-bridge-config-file": "node validation/remote-bridge-config-file/run-remote-bridge-config-file-validation.mjs",
    "validate:feishu-remote-bridge": "node validation/feishu-remote-bridge/run-feishu-remote-bridge-validation.mjs",
    "validate:feishu-remote-bridge-service": "node validation/feishu-remote-bridge-service/run-feishu-remote-bridge-service-validation.mjs",
    "validate:remote-session-adapter": "node validation/remote-session-adapter/run-remote-session-adapter-validation.mjs",
    "validate:remote-work-command-router": "node validation/remote-work-command-router/run-remote-work-command-router-validation.mjs",
    "validate:remote-output-delivery": "node validation/remote-output-delivery/run-remote-output-delivery-validation.mjs",
    "validate:remote-bridge-audit": "node validation/remote-bridge-audit/run-remote-bridge-audit-validation.mjs",
    "validate:terminal-remote-compatibility": "node validation/terminal-remote-compatibility/run-terminal-remote-compatibility-validation.mjs",
    "validate:codex-app-server-spike": "node validation/codex-app-server-spike/run-codex-app-server-spike-validation.mjs",
    "validate:structured-codex-adapter": "node validation/structured-codex-adapter/run-structured-codex-adapter-validation.mjs",
    "validate:remote-target-mode": "node validation/remote-target-mode/run-remote-target-mode-validation.mjs",
    "validate:workspace-profiles": "node validation/workspace-profiles/run-workspace-profiles-validation.mjs",
    "validate:visual-smoke": "node validation/visual-smoke/run-visual-smoke-validation.mjs",
    "validate:package-win": "node validation/package-win/run-package-win-validation.mjs --channel alpha",
    "validate:package-win-beta": "node validation/package-win/run-package-win-validation.mjs --channel beta",
    "validate:renderer-startup": "node validation/renderer-startup/run-renderer-startup-validation.mjs",
    "validate:renderer-entrypoint": "node validation/renderer-entrypoint.mjs",
    "validate:security-boundaries": "node validation/security-boundaries/run-security-boundaries-validation.mjs",
    "validate:openspec-active-changes": "node validation/openspec-active-changes/run-openspec-active-changes-validation.mjs",
    "validate:internal-alpha": "npm run typecheck && npm run validate:workspace-retrieval && npm run build && npm run validate:renderer-entrypoint && npm run validate:security-boundaries && npm run validate:visual-smoke && npm run validate:workspace-regression && npm run validate:workspace-web-capture && npm run validate:custom-web-panels && npm run validate:terminal-panel-configuration && npm run validate:terminal-behavior && npm run validate:remote-bridge-settings && npm run validate:remote-bridge-config-file && npm run validate:feishu-remote-bridge && npm run validate:feishu-remote-bridge-service && npm run validate:remote-session-adapter && npm run validate:remote-work-command-router && npm run validate:remote-output-delivery && npm run validate:remote-bridge-audit && npm run validate:terminal-remote-compatibility && npm run validate:codex-app-server-spike && npm run validate:structured-codex-adapter && npm run validate:remote-target-mode && npm run validate:workspace-profiles",
    "release:win-alpha": "npm run validate:internal-alpha && npm run package:win-alpha && npm run validate:package-win",
    "release:win-beta": "npm run validate:internal-alpha && npm run package:win-beta && npm run validate:package-win-beta"
  },
  "dependencies": {
    "@ai-workbench/core": "0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.14.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
