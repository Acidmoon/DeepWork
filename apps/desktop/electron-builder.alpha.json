{
  "appId": "cn.deepwork.alpha",
  "productName": "DeepWork",
  "electronVersion": "37.10.3",
  "directories": {
    "output": "../../release/windows-alpha"
  },
  "files": [
    "out/**",
    "package.json",
    "!node_modules/@ai-workbench/core/**",
    "!src/**",
    "!**/src/**",
    "!validation/**",
    "!*.ts",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/test/**",
    "!**/tests/**",
    "!electron.vite.config.ts",
    "!electron-builder*.json",
    "!tsconfig*.json",
    "!dist/**",
    "!release/**",
    "!node_modules/.vite/**",
    "!node_modules/node-pty/build/**",
    "!node_modules/node-pty/deps/**",
    "!node_modules/node-pty/node-addon-api/**",
    "!node_modules/node-pty/scripts/**",
    "!node_modules/node-pty/third_party/**",
    "!node_modules/node-pty/typings/**",
    "!node_modules/node-pty/prebuilds/darwin-*/**",
    "!node_modules/node-pty/prebuilds/win32-arm64/**",
    "!**/*.map",
    "!**/*.vcxproj",
    "!**/*.vcxproj.filters",
    "!**/*.gyp",
    "!**/*.gypi",
    "!**/.playwright-cli/**",
    "!**/artifacts/**",
    "!**/*.log"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/node-pty/prebuilds/win32-x64/**"
  ],
  "npmRebuild": false,
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  }
}
